# LinguaRoom backend configuration (all optional).

# Set to "0" to disable AI translation entirely (chat still works, everyone
# sees the original message text).
USE_DEEPSEEK=1

# Optional free DeepSeek web-account token. Only required if you want to use
# the newer `dsk` backend. If empty, the token-less legacy `deepseek` package
# is used (no account needed). Get it from chat.deepseek.com localStorage key
# "userToken" -> value.
DEEPSEEK_TOKEN=

# Tuning
TRANSLATE_CONCURRENCY=4
TRANSLATE_TIMEOUT=45
TRANSLATE_CACHE_SIZE=2000
MAX_HISTORY=200
